# host verification workspace (cloned deps + objects)
tests/host/.deps/
tests/host/.build/

# build & scratch artifacts
*.o
*.ppm
__pycache__/
.pio/
node_modules/
.DS_Store

# private signing keys never belong in git, wherever they land — block_sign.py
# keygen writes into the current directory, which is often the repo root.
*.key
# keygen drops the public half beside it; the copy that matters is the one
# pasted into firmware/epaper_dashboard/trusted_keys.h, so root-level scratch
# is ignored rather than committed by accident.
/*.pub.pem
