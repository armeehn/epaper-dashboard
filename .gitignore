# host verification workspace (cloned deps + objects)
tests/host/.deps/
tests/host/.build/

# build & scratch artifacts
*.o
*.ppm
__pycache__/
.pio/
node_modules/
.DS_Store

# real signing keys never belong in git — wherever they land. block_sign.py
# keygen writes into the current directory, which is often the repo root.
# the demo key is the documented, intentionally-public exception.
*.key
!registry/keys/demo-registry.key
